    jumlahBayar           Float
    metodePembayaran      String?        // CASH, TRANSFER, GIRO, dll
    nomorReferensi        String?        // Nomor bukti bayar
    keterangan            String?
    dibayarOleh           String         // Username yang mencatat pembayaran
    
    createdAt             DateTime       @default(now())
    
