}

// Model Penerimaan Piutang - Record setiap pembayaran dari buyer
model PenerimaanPiutang {
    id                    String    @id @default(cuid())
    piutangId             String
    
    tanggalTerima         DateTime  @default(now())
    jumlahTerima          Float
    metodePembayaran      String?   // CASH, TRANSFER, GIRO, dll
    nomorReferensi        String?   // Nomor bukti terima
    keterangan            String?
    diterimaOleh          String    // Username yang mencatat penerimaan
    
    createdAt             DateTime  @default(now())
    
    piutang               Piutang   @relation(fields: [piutangId], references: [id], onDelete: Cascade)
    
    @@index([piutangId])
    @@index([tanggalTerima])
}

// ============================================
// MODUL PENGGAJIAN KARYAWAN
// ============================================

// Master Data Divisi - Daftar divisi/departemen
model MasterDivisi {
    id        String   @id

    nama      String
    isActive  Boolean  @default(true)
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
    
    karyawan  MasterKaryawan[]
    jabatan   MasterJabatan[]
    
    @@index([isActive])
}

// Master Data Jabatan - Daftar jabatan/posisi (optional relation to Divisi)
model MasterJabatan {
    id        String   @id

    nama      String
    level     Int?
    isActive  Boolean  @default(true)
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
    
    // Optional relation to Divisi
    divisiId  String?
    divisi    MasterDivisi? @relation(fields: [divisiId], references: [id], onDelete: SetNull, onUpdate: Cascade)
    
    karyawan  MasterKaryawan[]
    
    @@index([isActive])
    @@index([divisiId])
}

// Master Data Karyawan - Data tetap karyawan (TIDAK DIHAPUS)
model MasterKaryawan {
    id                    String   @id @default(cuid())
    
    // Identitas Karyawan
    namaKaryawan          String   // NAMA KARYAWAN
    
    // Relasi ke Divisi & Jabatan
    divisiId              String?
    jabatanId             String?
    divisi                MasterDivisi?  @relation(fields: [divisiId], references: [id], onUpdate: Cascade)
    jabatan               MasterJabatan? @relation(fields: [jabatanId], references: [id], onUpdate: Cascade)
    
    // Data Karyawan Lainnya
    gol                   String?  // GOL (Golongan)
    tktk                  String?  // TK/K (Status keluarga)
    
    // Informasi Rekening & BPJS
    nomorRekening         String?  // NOMOR REKENING
    noBpjsTk              String?  // NO BPJS TK
    noBpjsKesehatan       String?  // NO BPJS KESEHATAN
    
    // ========== GAJI (SALARY BASE) ==========
    gajiPokok             Decimal  @default(0) @db.Decimal(15, 0)  // Gaji Pokok
    tunjanganJabatan      Decimal  @default(0) @db.Decimal(15, 0)  // Tunjangan Jabatan
    tunjanganPerumahan    Decimal  @default(0) @db.Decimal(15, 0)  // Tunjangan Perumahan
    
    // ========== POTONGAN BPJS (FIXED NOMINAL) ==========
    potBpjsTkJht          Decimal  @default(0) @db.Decimal(15, 0)
    potBpjsTkJn           Decimal  @default(0) @db.Decimal(15, 0)
    potBpjsKesehatan      Decimal  @default(0) @db.Decimal(15, 0)
    
    // ========== STATUS KARYAWAN ==========
    tanggalMulaiKerja     DateTime?
    tanggalKeluar         DateTime?  // Tanggal resign/keluar
    isActive              Boolean  @default(true)
    
    createdAt             DateTime @default(now())
    updatedAt             DateTime @updatedAt
    
    // Relations
    penggajian            PenggajianKaryawan[]
    changeLogs            KaryawanChangeLog[]
    
    @@index([namaKaryawan])
    @@index([divisiId])
    @@index([jabatanId])
    @@index([isActive])
}

// Log perubahan data karyawan
model KaryawanChangeLog {
    id                String   @id @default(cuid())
    masterKaryawanId  String
    fieldName         String   // Field yang berubah (divisiId, jabatanId, gajiPokok, etc)
    oldValue          String?  // Nilai lama
    newValue          String?  // Nilai baru
    oldDisplayValue   String?  // Nilai tampilan lama (nama divisi/jabatan)
    newDisplayValue   String?  // Nilai tampilan baru
    changedBy         String   // Username yang mengubah
    changedAt         DateTime @default(now())
    
    masterKaryawan    MasterKaryawan @relation(fields: [masterKaryawanId], references: [id], onDelete: Cascade)
    
    @@index([masterKaryawanId])
    @@index([changedAt])
}

model PenggajianKaryawan {
    id                    String   @id @default(cuid())
    
    // Reference to Master Karyawan (required)
    masterKaryawanId      String
    masterKaryawan        MasterKaryawan @relation(fields: [masterKaryawanId], references: [id], onDelete: Restrict)
    
    // Periode Gaji
    periodeBulan          Int      // 1-12
    periodeTahun          Int      // 2024, 2025, etc
    
    // ========== SNAPSHOT SALARY (dari master saat generate) ==========
    gajiPokok             Decimal  @default(0) @db.Decimal(15, 0)
    tunjanganJabatan      Decimal  @default(0) @db.Decimal(15, 0)
    tunjanganPerumahan    Decimal  @default(0) @db.Decimal(15, 0)
    tunjanganLainLain     Decimal  @default(0) @db.Decimal(15, 0)
    
    // ========== HARI KERJA (ATTENDANCE) ==========
    hk                    Int      @default(0)  // HK (Hari Kerja)
    hkDibayar             Int      @default(0)  // HK Dibayar
    hkTidakDibayar        Int      @default(0)  // HK Tidak Dibayar
    liburDibayar          Int      @default(0)  // Libur Dibayar
    hariBelumMasuk        Int      @default(0)  // Hari Belum Masuk Kerja (untuk karyawan masuk pertengahan bulan)
    tanggalKerja          Json?    // Detail attendance per tanggal { "1": "WK", "2": "Off", ... }
    
    // ========== OVERTIME ==========
    overtime              Decimal  @default(0) @db.Decimal(15, 0)  // Overtime (rupiah)
    lemburHari            Float    @default(0)  // Lembur (hari) - backward compatibility
    totalMenit            Int      @default(0)  // Total menit lembur
    totalMenitDibayar     Int      @default(0)  // Total menit dibayar (setelah multiplier)
    lemburDetail          Json?    // Detail lembur per tanggal
    
    // ========== POTONGAN ==========
    potKehadiran          Decimal  @default(0) @db.Decimal(15, 0)
    potPinjaman           Decimal  @default(0) @db.Decimal(15, 0)
    potLainLain           Decimal  @default(0) @db.Decimal(15, 0)
    potBpjsTkJht          Decimal  @default(0) @db.Decimal(15, 0)
    potBpjsTkJn           Decimal  @default(0) @db.Decimal(15, 0)
    potBpjsKesehatan      Decimal  @default(0) @db.Decimal(15, 0)
    potPph21              Decimal  @default(0) @db.Decimal(15, 0)
    totalPotongan         Decimal  @default(0) @db.Decimal(15, 0)
    
    // ========== HASIL ==========
    totalSebelumPotongan  Decimal  @default(0) @db.Decimal(15, 0)
    upahDiterima          Decimal  @default(0) @db.Decimal(15, 0)
    
    // ========== ADDITIONAL ==========
    thr                   Decimal  @default(0) @db.Decimal(15, 0)
    sppd                  Decimal  @default(0) @db.Decimal(15, 0)
    keteranganDetail      Json?    // { sppd?: string; tunjanganLainLain?: string }
    
    createdAt             DateTime @default(now())
    updatedAt             DateTime @updatedAt
    
    @@index([periodeTahun, periodeBulan])
    @@index([masterKaryawanId])
}

// Model Pembayaran PR - Record pembayaran untuk PR Pembelian Langsung
model PembayaranPR {
    id                    String           @id @default(cuid())
    purchaseRequestId     String
    
    tanggalBayar          DateTime         @default(now())
    jumlahBayar           Float
    metodePembayaran      String?          // CASH, TRANSFER, GIRO, dll
