// ============================================
// MODUL INVOICE PENGIRIMAN PRODUK
// ============================================

// Enum untuk status invoice
enum StatusInvoice {
    DRAFT           // Baru dibuat
    ISSUED          // Sudah diterbitkan
    PARTIAL_PAID    // Sebagian dibayar
    PAID            // Lunas
    CANCELLED       // Dibatalkan
}

// Model Invoice - Invoice untuk pengiriman produk ke buyer
model Invoice {
    id                    String         @id @default(cuid())
    companyId             String
    
    // Informasi Invoice
    nomorInvoice          String         @unique
    tanggalInvoice        DateTime       @default(now())
    tanggalJatuhTempo     DateTime?
    
    // Referensi Kontrak
    contractId            String
    buyerId               String
    
    // Nilai Dasar
    totalBerat            Float          @default(0)  // Total berat netto (kg)
    hargaPerKg            Float          @default(0)  // Harga per kg dari kontrak
    subtotalBruto         Float          @default(0)  // totalBerat * hargaPerKg
    
    // Klaim Mutu (potongan berdasarkan mutu)
    klaimMutuPersen       Float          @default(0)  // Persentase klaim mutu
    klaimMutuNilai        Float          @default(0)  // Nilai klaim mutu (subtotalBruto * klaimMutuPersen / 100)
    klaimMutuKeterangan   String?                     // Keterangan klaim mutu
    
    // Klaim Susut (potongan berdasarkan susut/shrinkage)
    klaimSusutPersen      Float          @default(0)  // Persentase klaim susut
    klaimSusutNilai       Float          @default(0)  // Nilai klaim susut (subtotalBruto * klaimSusutPersen / 100)
    klaimSusutKeterangan  String?                     // Keterangan klaim susut
    
    // Total Potongan
    totalPotongan         Float          @default(0)  // klaimMutuNilai + klaimSusutNilai
    
    // Nilai Setelah Potongan
    subtotalNetto         Float          @default(0)  // subtotalBruto - totalPotongan
    
    // Pajak
    ppnPersen             Float          @default(0)  // PPN (%) - dari status pajak buyer
    ppnNilai              Float          @default(0)  // Nilai PPN
    pphPersen             Float          @default(0)  // PPh (%) jika ada
    pphNilai              Float          @default(0)  // Nilai PPh
    
    // Total Akhir
    totalNilai            Float          @default(0)  // subtotalNetto + ppnNilai - pphNilai
    
    // Pembayaran
    totalDibayar          Float          @default(0)
    sisaPembayaran        Float          @default(0)  // totalNilai - totalDibayar
    
    // Catatan
    catatan               String?
    
    // PPN Disclaimer (untuk ditampilkan di PDF)
    showPpnDisclaimer     Boolean        @default(false)
    
    // Penandatangan Invoice
    namaPenandatangan     String?        @default("TARA MIFTAHUR")
    jabatanPenandatangan  String?        @default("Direktur")
    
    // Status
    status                StatusInvoice  @default(DRAFT)
    
    // Operator
    createdBy             String         // Username yang membuat
    issuedBy              String?        // Username yang menerbitkan
    tanggalIssued         DateTime?
    
    createdAt             DateTime       @default(now())
    updatedAt             DateTime       @updatedAt
    
    // Relations
    contract              Contract       @relation(fields: [contractId], references: [id], onDelete: Cascade)
    buyer                 Buyer          @relation(fields: [buyerId], references: [id], onDelete: Cascade)
    invoiceItems          InvoiceItem[]
    pembayaranInvoice     PembayaranInvoice[]
    
    @@index([companyId])
    @@index([nomorInvoice])
    @@index([contractId])
    @@index([buyerId])
    @@index([tanggalInvoice])
    @@index([status])
}

// Model InvoiceItem - Item detail dalam invoice (pengiriman yang di-invoice)
model InvoiceItem {
    id                    String             @id @default(cuid())
    invoiceId             String
    pengirimanProductId   String             @unique // One pengiriman can only be invoiced once
    
    // Data dari pengiriman
    nomorPengiriman       String
    tanggalPengiriman     DateTime
    beratNetto            Float              // Berat netto dari pengiriman
    
    // Mutu
    ffa                   Float?
    air                   Float?
    kotoran               Float?
    
    // Nilai
    hargaSatuan           Float
    subtotal              Float              // beratNetto * hargaSatuan
    
    // Klaim per item (opsional)
    klaimMutuPersen       Float              @default(0)
    klaimMutuNilai        Float              @default(0)
    klaimSusutPersen      Float              @default(0)
    klaimSusutNilai       Float              @default(0)
    totalPotongan         Float              @default(0)
    totalBersih           Float              @default(0)  // subtotal - totalPotongan
    
    keterangan            String?
    
    createdAt             DateTime           @default(now())
    updatedAt             DateTime           @updatedAt
    
    invoice               Invoice            @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
    pengirimanProduct     PengirimanProduct  @relation(fields: [pengirimanProductId], references: [id], onDelete: Cascade)
    
    @@index([invoiceId])
    @@index([pengirimanProductId])
}

// Model Pembayaran Invoice - Record pembayaran dari buyer
model PembayaranInvoice {
    id                    String    @id @default(cuid())
    invoiceId             String
    
    tanggalBayar          DateTime  @default(now())
    jumlahBayar           Float
    metodePembayaran      String?   // CASH, TRANSFER, GIRO, dll
    nomorReferensi        String?   // Nomor bukti bayar
    keterangan            String?
    diterimaOleh          String    // Username yang mencatat pembayaran
    
    createdAt             DateTime  @default(now())
    
    invoice               Invoice   @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
    
    @@index([invoiceId])
    @@index([tanggalBayar])
}

// ========== NOTIFICATION SYSTEM ==========

// Enum untuk tipe notifikasi
enum NotificationType {
    PR_PENDING_APPROVAL   // PR menunggu approval
    PR_APPROVED           // PR disetujui
    PR_REJECTED           // PR ditolak
    PO_PENDING_APPROVAL   // PO menunggu approval
    PO_APPROVED           // PO disetujui
    PO_ISSUED             // PO diterbitkan
}

// Model Notification - Notifikasi dalam aplikasi
model Notification {
    id            String           @id @default(cuid())
    companyId     String
    userId        String           // Target user yang menerima notifikasi
    type          NotificationType
    title         String           // Judul notifikasi
    message       String           // Pesan notifikasi
    referenceId   String?          // ID dari PR/PO terkait (nullable)
    referenceUrl  String?          // URL untuk navigasi saat diklik
    isRead        Boolean          @default(false)
    createdAt     DateTime         @default(now())
    
    user          User             @relation(fields: [userId], references: [id], onDelete: Cascade)
    company       Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
    
    @@index([userId])
    @@index([companyId])
    @@index([isRead])
    @@index([createdAt])
}

// Enum untuk status biaya
enum StatusBiaya {
    DRAFT       // Baru dibuat
    ACTIVE      // Aktif/tercatat
    PAID        // Sudah dibayar
    CANCELLED   // Dibatalkan
}

// Model Biaya Pengeluaran - Pencatatan biaya operasional perusahaan
model BiayaPengeluaran {
    id              String         @id @default(cuid())
    companyId       String
    nomorBiaya      String         @unique  // Auto-generated: BP-YYYYMM-XXXX
    tanggalBiaya    DateTime       @default(now())
    kategoriBiaya   String
    deskripsi       String         // Deskripsi biaya
    jumlahBiaya     Float          // Jumlah nominal biaya
    periodeBulan    Int?           // Optional: bulan periode (1-12)
    periodeTahun    Int?           // Optional: tahun periode
    keterangan      String?        // Keterangan tambahan
    status          StatusBiaya    @default(ACTIVE)
    dibuatOleh      String         // Username yang membuat
    
    pengajuanBiayaOperasionalId String? @unique
    pengajuanBiayaOperasional   PengajuanBiayaOperasional? @relation(fields: [pengajuanBiayaOperasionalId], references: [id], onDelete: SetNull)

    createdAt       DateTime       @default(now())
    updatedAt       DateTime       @updatedAt
    
    company         Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
    
    @@index([companyId])
    @@index([kategoriBiaya])
    @@index([tanggalBiaya])
    @@index([status])
    @@index([periodeBulan, periodeTahun])
}

// Enum untuk status pengajuan biaya operasional
enum StatusPengajuanBiaya {
    DRAFT       // Draft, belum diajukan
    PENDING     // Menunggu persetujuan (approval)
    APPROVED    // Disetujui (otomatis masuk ke Biaya Pengeluaran)
    REJECTED    // Ditolak
    PAID        // Sudah dibayar di modul Keuangan
    CANCELLED   // Dibatalkan
}

// Model Pengajuan Biaya Operasional (alur mirip PR dengan kategori biaya operasional)
model PengajuanBiayaOperasional {
    id                  String                          @id @default(cuid())
    companyId           String
    nomorPengajuan      String                          @unique // Format: BO-YYYYMM-XXXX
    tanggalPengajuan    DateTime                        @default(now())
    divisi              String                          // Divisi yang mengajukan
    kategoriBiaya       String                          // Kategori biaya operasional (PLN, OPERASIONAL_KEUANGAN, dll)
    keperluan           String                          // Uraian/keperluan pengajuan
    totalBiaya          Float                           // Total estimasi biaya
    requestedBy         String                          // Diajukan oleh (username/nama)
    approvedBy          String?                         // Disetujui oleh (username/nama)
    tanggalApproval     DateTime?                       // Tanggal persetujuan
    alasanReject        String?                         // Alasan jika ditolak
    catatan             String?                         // Catatan tambahan
    status              StatusPengajuanBiaya            @default(DRAFT)
    
    createdAt           DateTime                        @default(now())
    updatedAt           DateTime                        @updatedAt
    
    company             Company                         @relation(fields: [companyId], references: [id], onDelete: Cascade)
    items               PengajuanBiayaOperasionalItem[]
    biayaPengeluaran    BiayaPengeluaran?
    
    @@index([companyId])
    @@index([tanggalPengajuan])
    @@index([status])
    @@index([kategoriBiaya])
    @@index([divisi])
}

// Item rincian Pengajuan Biaya Operasional (mirip item PR)
model PengajuanBiayaOperasionalItem {
    id                  String                     @id @default(cuid())
    pengajuanId         String
    deskripsi           String                     // Nama item / uraian kebutuhan
    jumlah              Float                      // Kuantitas / Qty
    satuan              String                     // Satuan (unit, bulan, paket, pcs, dll)
    estimasiHarga       Float                      // Estimasi harga satuan
    subtotal            Float                      // jumlah * estimasiHarga
    keterangan          String?                    // Keterangan per item
    
    createdAt           DateTime                   @default(now())
    updatedAt           DateTime                   @updatedAt
    
    pengajuan           PengajuanBiayaOperasional  @relation(fields: [pengajuanId], references: [id], onDelete: Cascade)
    
    @@index([pengajuanId])
}
